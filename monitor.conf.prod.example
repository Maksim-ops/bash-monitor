TELEGRAM_CHAT_ID="-1001234567890"
TELEGRAM_BOT_TOKEN="123456789:replace-me"

ALERT_PREFIX="[lifeorient-monitor PROD]"
HOSTNAME_LABEL="lifeorient"
STATE_DIR="/root/monitor/.monitor-state"
LOG_FILE="/var/log/lifeorient-monitor.log"

EXPECTED_HTTP_STATUS=200
HTTP_FAILURE_THRESHOLD=3
HTTP_TIMEOUT=15
DISK_USAGE_THRESHOLD=90
CPU_USAGE_THRESHOLD=90
MEMORY_USAGE_THRESHOLD=90
RESOURCE_FAILURE_THRESHOLD=3
CPU_SAMPLE_SECONDS=1
LOG_INITIAL_LOOKBACK_SECONDS=300

add_container_check "proxy" "proxy" "Docker: proxy"
add_container_check "le" "le" "Docker: le"
add_container_check "reports_nginx" "reports-nginx" "Docker: reports-nginx"
add_container_check "reports_web" "reports-web" "Docker: reports-web"
add_container_check "reports_php" "reports-php" "Docker: reports-php"
add_container_check "reports_db" "reports-db" "Docker: reports-db"
add_container_check "lifeorient" "lifeorient" "Docker: lifeorient"
add_container_check "lifeorient_db" "lifeorient-db" "Docker: lifeorient-db"
add_container_check "messenger_nginx" "messenger-nginx" "Docker: messenger-nginx"
add_container_check "messenger_php" "messenger-php" "Docker: messenger-php"
add_container_check "messenger_worker" "messenger-worker" "Docker: messenger-worker"

add_http_check "lifeorient_home" "https://lifeorient.org" "HTTP: lifeorient.org" 200 3 15
add_http_check "reports_home" "https://reports.lifeorient.org" "HTTP: reports.lifeorient.org" 200 3 15
add_http_check "reports_api" "https://api.reports.lifeorient.org" "HTTP: api.reports.lifeorient.org" 401 3 15

add_db_check \
  "reports_db_dev_recent_message_statuses" \
  "docker exec reports-db-dev env MYSQL_PWD='replace-me' mysql -N -B -uroot reports -e 'SELECT * FROM messages WHERE statuses IN (06, 60, 66) AND \`updated_at\` >= NOW() - INTERVAL 1 MINUTE'" \
  "MySQL: reports-db-dev messages with statuses 06/60/66 in the last minute" \
  ""

add_disk_check "root_disk" "/" "Disk: /" 90
add_resource_check "host_resources" "Host resources" 90 90 3
