TELEGRAM_CHAT_ID="-1001234567890"
TELEGRAM_BOT_TOKEN="123456789:replace-me"

ALERT_PREFIX="[lifeorient-monitor PROD]"
HOSTNAME_LABEL="lifeorient"
STATE_DIR="/root/monitor/.monitor-state"
LOG_FILE="/var/log/lifeorient-monitor.log"
EVENTS_LOG_FILE="/var/log/lifeorient-monitor-events.log"

EXPECTED_HTTP_STATUS=200
HTTP_FAILURE_THRESHOLD=3
HTTP_TIMEOUT=5
DISK_USAGE_THRESHOLD=95
CPU_USAGE_THRESHOLD=90
MEMORY_USAGE_THRESHOLD=95
RESOURCE_FAILURE_THRESHOLD=3
CPU_SAMPLE_SECONDS=1

add_containers proxy le reports-nginx reports-web reports-php reports-db redirect lifeorient lifeorient-nginx lifeorient-db lifeorient_redirect messenger-nginx messenger-php messenger-worker
add_container_check "mp3" "mp3" "Docker: mp3 (j316.ru)"

add_http_check "lifeorient_home" "https://lifeorient.org" "HTTP: lifeorient.org" 200 3 15
add_http_check "reports_home" "https://reports.lifeorient.org" "HTTP: reports.lifeorient.org" 200 3 15
add_http_check "reports_api" "https://api.reports.lifeorient.org" "HTTP: api.reports.lifeorient.org" 401 3 15
add_http_check "j316_home" "https://j316.ru" "HTTP: j316.ru" 302 3 15

add_disk_check "root_disk" "/" "Disk: /" 95
add_resource_check "host_resources" "Host resources" 90 95 3

add_log_check \
  "reports_app_events" \
  "/root/reports/uploads/events.log" \
  "Errors: reports app" \
  "" \
  ""

# --- логи nginx и PHP ---
# error.log nginx: каталоги /var/log/lifeorient/<имя>/ смонтированы в контейнеры.
# Шум сканеров WordPress (access forbidden by rule / directory index forbidden — десятки тысяч строк в сутки) отфильтрован.
add_log_check "reports_nginx_errors" "/var/log/lifeorient/reports-nginx/error.log" "Errors: reports-nginx error.log" "\[(error|crit|alert|emerg)\]"
add_log_check "wordpress_nginx_errors" "/var/log/lifeorient/wordpress-nginx/error.log" "Errors: wordpress-nginx error.log" "\[(error|crit|alert|emerg)\]" "access forbidden by rule|directory index of .* is forbidden"
# приложения мессенджера (сейчас в них только INFO)
add_log_check "messenger_max_log" "/root/messenger-api/logs/max.log" "Errors: messenger max.log" "\[(WARNING|ERROR|CRITICAL)\]"
add_log_check "messenger_telegram_log" "/root/messenger-api/logs/telegram.log" "Errors: messenger telegram.log" "\[(WARNING|ERROR|CRITICAL)\]"
# PHP-FPM пишет только в docker logs (файла нет): фатальные ошибки, падения воркеров и нехватка pm.max_children за последние 5 минут
# (предупреждения WordPress вроде "PHP Warning ... class-wp-site-health.php" сознательно не ловим — это шум)
add_command_check "reports_php_errors" "docker logs --since 5m reports-php 2>&1 | grep -E 'PHP (Fatal|Parse) error|Fatal error|Uncaught|segfault|exited on signal|server reached pm\\.max_children' | cut -c1-300 | tail -3" "PHP: reports-php errors" "" 1
add_command_check "lifeorient_php_errors" "docker logs --since 5m lifeorient 2>&1 | grep -E 'PHP (Fatal|Parse) error|Fatal error|Uncaught|segfault|exited on signal|server reached pm\\.max_children' | cut -c1-300 | tail -3" "PHP: lifeorient (WordPress) errors" "" 1
add_command_check "messenger_php_errors" "docker logs --since 5m messenger-php 2>&1 | grep -E 'PHP (Fatal|Parse) error|Fatal error|Uncaught|segfault|exited on signal|server reached pm\\.max_children' | cut -c1-300 | tail -3" "PHP: messenger-php errors" "" 1

# --- SSH-туннель к домашнему сервису (d.lifeorient.org) ---
add_containers tunnel-nginx tunnel-cert-issuer
# конец туннеля на VPS: если упало — проблема в SSH-туннеле или в домашнем сервисе
add_http_check "tunnel_endpoint" "http://127.0.0.1:18443/health" "Tunnel: SSH-туннель / домашний сервис (127.0.0.1:18443)" 200 3 10
# вся цепочка снаружи: DNS -> VPS -> TLS -> туннель -> дом
add_http_check "tunnel_public" "https://d.lifeorient.org:8443/health" "HTTP: d.lifeorient.org:8443 (через туннель)" 200 3 15
# срок действия сертификата меньше 14 дней
add_command_check "tunnel_cert_expiry" "echo | openssl s_client -connect 127.0.0.1:8443 -servername d.lifeorient.org 2>/dev/null | openssl x509 -noout -checkend 1209600 >/dev/null || echo \"cert d.lifeorient.org expires in <14 days or unreachable\"" "Cert: d.lifeorient.org" ""

# --- расширенные проверки сервиса материалов (дома) и второго адреса d.j316.ru ---
add_http_check "tunnel_deep" "http://127.0.0.1:18443/api/health/full?key=replace-with-MONITOR_KEY" "Сервис дома: БД, конвертер, место на диске" 200 2 15
add_containers tunnel-cert-issuer-j316
add_http_check "tunnel_public_j316" "https://d.j316.ru:8443/health" "HTTP: d.j316.ru:8443 (через туннель)" 200 3 15
add_command_check "tunnel_cert_expiry_j316" "echo | openssl s_client -connect 127.0.0.1:8443 -servername d.j316.ru 2>/dev/null | openssl x509 -noout -checkend 1209600 >/dev/null || echo \"cert d.j316.ru expires in <14 days or unreachable\"" "Cert: d.j316.ru" ""

# --- бот-помощник волонтёров (reports-helper) ---
add_containers reports-helper
# бот раз в 5 минут пишет tg_probe ok|SLOW|FAIL (запрос getMe к Telegram); тревога, если ПОСЛЕДНЯЯ проверка за 15 минут — FAIL
# (пока в логе не появится ok, проверка остаётся в тревоге; сам алерт уходит в Telegram и при полной блокировке может не дойти)
add_command_check "reports_helper_tg_fail" "docker logs --since 15m reports-helper 2>&1 | grep tg_probe | tail -1 | grep FAIL || true" "Bot: нет связи с Telegram (tg_probe FAIL)" "" 1
# бот завис: за 15 минут ни одной строки tg_probe
add_command_check "reports_helper_tg_silent" "docker logs --since 15m reports-helper 2>&1 | grep -q tg_probe || echo 'нет строк tg_probe за 15 минут: бот завис или перезапускается'" "Bot: нет проверок связи (tg_probe)" "" 2
# docker HEALTHCHECK бота (файл /tmp/alive обновляется раз в 30 с); 3 минуты подряд не healthy — тревога
add_container_health_check "reports_helper_health" "reports-helper" "Docker health: reports-helper" 3

# --- зависимости алертов ---
# Если сломалось более общее (контейнер, прокси, туннель до дома), зависимые
# проверки не шлют свои алерты: шум не нужен, причина уже в одном сообщении.
# Если зависимая проверка продолжит падать после восстановления родителя — алерт придёт тогда.
# Родитель должен быть объявлен в конфиге выше зависимого.
depends_on "reports_home"  "proxy" "reports_web"
depends_on "reports_api"   "proxy" "reports_nginx" "reports_php" "reports_db"
depends_on "lifeorient_home" "proxy" "lifeorient_nginx" "lifeorient" "lifeorient_db"
depends_on "j316_home"     "proxy" "mp3"
# туннель до домашнего lifeorient-storage: когда дом недоступен (tunnel_endpoint), всё, что идёт через него, молчит
depends_on "tunnel_public"      "tunnel_endpoint" "tunnel_nginx"
depends_on "tunnel_public_j316" "tunnel_endpoint" "tunnel_nginx"
depends_on "tunnel_deep"        "tunnel_endpoint"
depends_on "tunnel_cert_expiry"      "tunnel_nginx"
depends_on "tunnel_cert_expiry_j316" "tunnel_nginx"
depends_on "reports_php_errors"    "reports_php"
depends_on "lifeorient_php_errors" "lifeorient"
depends_on "messenger_php_errors"  "messenger_php"
# бот-помощник
depends_on "reports_helper_tg_fail"   "reports_helper"
depends_on "reports_helper_tg_silent" "reports_helper"
depends_on "reports_helper_health"    "reports_helper"
