# Copy this file to monitor.conf and change the values below.

TELEGRAM_BOT_TOKEN="123456789:replace-me"
TELEGRAM_CHAT_ID="-1001234567890"

# Optional settings.
# TELEGRAM_MESSAGE_THREAD_ID="42"
# TELEGRAM_DISABLE_NOTIFICATION=1
# Pauses (seconds) before each retry of a failed Telegram send; default "10 20" = 3 tries in total:
# TELEGRAM_RETRY_DELAYS="10 20"
# LOG_FILE="/var/log/lifeorient-monitor.log"
# Journal of every ALERT/RESOLVED with full details (default: <LOG_FILE minus .log>-events.log):
# EVENTS_LOG_FILE="/var/log/lifeorient-monitor-events.log"
ALERT_PREFIX="[lifeorient-monitor]"
HOSTNAME_LABEL="prod-server-1"
STATE_DIR="${SCRIPT_DIR}/.monitor-state"

EXPECTED_HTTP_STATUS=200
HTTP_FAILURE_THRESHOLD=3
HTTP_TIMEOUT=10
DISK_USAGE_THRESHOLD=90
CPU_USAGE_THRESHOLD=90
MEMORY_USAGE_THRESHOLD=90
RESOURCE_FAILURE_THRESHOLD=3
CPU_SAMPLE_SECONDS=1
LOG_INITIAL_LOOKBACK_SECONDS=300

# Container checks.
add_container_check "nginx_container" "nginx" "Docker: nginx"
add_container_check "php_fpm_container" "php-fpm" "Docker: php-fpm"

# Optional health checks for containers that define Docker HEALTHCHECK.
# Leave them disabled unless the container really exposes health status.
# add_container_health_check "nginx_health" "nginx" "Docker health: nginx" 1

# HTTP checks.
add_http_check "frontend_health" "http://127.0.0.1:8080/health" "HTTP: frontend health" 200 3 10
add_http_check "api_health" "http://127.0.0.1:8081/health" "HTTP: api health" 200 3 10

# DB checks. The command should return empty output when everything is fine.
# If match_regex is empty, any non-empty output triggers an alert.
# Use -N -B for mysql so the output stays compact.
add_db_check \
  "stuck_payments" \
  "docker exec mysql-db env MYSQL_PWD='change-me' mysql -N -B -uroot app_db -e \"SELECT CONCAT(id, ':', status) FROM payments WHERE status = 'STUCK' LIMIT 10\"" \
  "MySQL: stuck payments" \
  ""

# Custom command check example for future extensions.
# add_command_check \
#   "custom_probe" \
#   "curl -fsS http://127.0.0.1:8090/internal/check | grep -i 'alarm'" \
#   "Custom: internal check" \
#   ""

# Disk usage.
add_disk_check "root_disk" "/" "Disk: /" 90

# Host CPU and memory.
add_resource_check "host_resources" "Host resources" 90 90 3

# Log monitoring. The script inspects only new log lines since the previous run.
add_log_check "php_exceptions" "php-fpm" "exception|fatal error|traceback" "Logs: php-fpm exceptions" 1 300

# File-based error monitoring: not tied to docker logs or any one service.
# Point it at any plain log file on the host and it notifies once per run
# that has new matching lines (not an ALERT-once/RESOLVED pair like
# add_log_check above) — meant for "tell me about every new error", e.g. a
# JSON-lines error/event log written by an app. Works for any number of
# files from any number of services, one add_file_error_check per file.
#   add_file_error_check <id> <file_path> [label] [include_regex] [exclude_regex]
# include_regex: only consider new lines matching this (empty = all new lines).
# exclude_regex: drop lines matching this even if include_regex matched — this
#   is how you silence specific error types without touching the app's code.
add_file_error_check \
  "app_events_example" \
  "/var/www/app/uploads/events.log" \
  "Errors: app events" \
  "" \
  "\"context\":\"some_noisy_known_issue\""

# Same file, but if the app's events.log carries a "level" field
# ("warning"/"error"/"critical"), you can filter on severity instead of (or
# together with) specific error types — e.g. only page for critical/error,
# stay quiet on routine warnings like an expired token or bad login:
# add_file_error_check \
#   "app_events_critical_only" \
#   "/var/www/app/uploads/events.log" \
#   "Errors: app events (critical+error only)" \
#   "" \
#   "\"level\":\"warning\""
